{
  "name": "eminent-hospice-office-flow",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run build:client && node scripts/build-worker.mjs",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts server/*.test.ts",
    "build:client": "next build",
    "db:generate": "drizzle-kit generate",
    "cf:whoami": "wrangler whoami",
    "cf:migrate": "wrangler d1 migrations apply DB --remote --profile eminent-hospice",
    "cf:deploy": "wrangler deploy --profile eminent-hospice",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/cloudflare"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "esbuild": "^0.25.12"
  }
}
